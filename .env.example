# ==========================================
# Ethiopian Upwork - Environment Variables
# ==========================================

# Application Port Settings
PORT=4000
FRONTEND_PORT=3000
AI_SERVICE_PORT=8000

# Database (PostgreSQL + pgvector)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ethiopian_upwork?schema=public
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=ethiopian_upwork
POSTGRES_PORT=5432

# Redis Cache & Queue
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379

# Authentication
JWT_SECRET=supersecretjwtkey_replace_in_production
JWT_REFRESH_SECRET=supersecretjwtrefreshkey_replace_in_production
JWT_EXPIRATION=1d
JWT_REFRESH_EXPIRATION=7d

# AI Microservice
AI_SERVICE_URL=http://localhost:8000

# File & Document Storage
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin
STORAGE_BUCKET=ethiopian-upwork

# Frontend Public Variables
NEXT_PUBLIC_API_URL=http://localhost:4000/api
NEXT_PUBLIC_SOCKET_URL=http://localhost:4000
